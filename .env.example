# SIMOLA deployment variables. Set them in the Coolify application, never commit real values (NFR-SEC-010).

SIMOLA_ENVIRONMENT=staging                 # production | staging | development
SIMOLA_LOG_LEVEL=INFO

# Database (owner = migrations only; app = least-privilege role used by api/worker, PRD DB-06)
POSTGRES_USER=simola_owner
POSTGRES_PASSWORD=change-me-owner
POSTGRES_DB=simola
SIMOLA_APP_DB_USER=simola_app
SIMOLA_APP_DB_PASSWORD=change-me-app
SIMOLA_PG_DATA_DIR=/var/lib/simola/staging/pg

# CDP log shares (host mount points, mounted read-only into the worker) and probe addresses
SIMOLA_CDP1_SHARE=/mnt/<cdp1-share-mount>
SIMOLA_CDP2_SHARE=/mnt/<cdp2-share-mount>
SIMOLA_CDP_ADDRESSES={"CDP1": "<cdp1-address>", "CDP2": "<cdp2-address>"}

# Backups (production): enable, choose the off-host upload command once OPEN-01 is decided
SIMOLA_BACKUP_ENABLED=false
SIMOLA_BACKUP_EXPECTED=false
SIMOLA_BACKUP_DIR=/var/lib/simola/staging/backups
SIMOLA_BACKUP_HOUR_UTC=18
SIMOLA_BACKUP_UPLOAD_CMD=
SIMOLA_BACKUP_RUN_ON_START=false

# Optional memory limits
SIMOLA_DB_MEM=1536m
SIMOLA_API_MEM=512m
# API worker processes; each needs ~150 MB of SIMOLA_API_MEM and 5 database connections (see core/db.py)
SIMOLA_API_WORKERS=2
SIMOLA_WORKER_MEM=512m
